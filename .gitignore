# produced locally, never committed.
*.pth
*.pt
groundingdino_swint_ogc.pth

# ── Datasets (symlinked or downloaded locally) ──────────────────────────
/datasets/
datasets/coco
datasets/odinw*

# ── Experiment outputs ──────────────────────────────────────────────────
output/
outputs/
*.log
*.out
*.nohup

# ── Environments / editors ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.idea/
.vscode/
.DS_Store
