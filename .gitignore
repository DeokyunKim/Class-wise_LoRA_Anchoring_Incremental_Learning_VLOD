# ── Byte-compiled / caches ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache
.ipynb_checkpoints

# ── Compiled CUDA extensions ────────────────────────────────────────────
# Built locally via Deformable-DETR/models/ops/make.sh (see README).
*.so
build/
*.egg-info/
*.egg

# ── Model weights / checkpoints ─────────────────────────────────────────
